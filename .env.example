# Scalpit Mobile App - Environment Configuration Example
# Duplicate this file as .env in your root directory

# Application Environment ('development' | 'staging' | 'production')
APP_ENV=development

# Backend API Base URL
API_BASE_URL=https://api.scalpit.io/v1

# Request Timeout in Milliseconds
API_TIMEOUT_MS=15000

# Development Mock Authentication Adapter (true = test UI without backend, false = use real backend)
USE_MOCK_AUTH=true

# Debug Logging in Development
ENABLE_DEBUG_LOGS=true

# Customer Support
SUPPORT_EMAIL=support@scalpit.io
